diff --git a/internal/pilot/terra_max_test.go b/internal/pilot/terra_max_test.go
new file mode 100644
index 0000000..77d6bc9
--- /dev/null
+++ b/internal/pilot/terra_max_test.go
@@ -0,0 +1,23 @@
+package pilot
+
+import (
+	"context"
+	"testing"
+)
+
+func TestTerraMaxThroughCompatibleGateway(t *testing.T) {
+	f := newFakeOpenAI(t, refuseTools, respondCall)
+	cfg := Config{Service: CustomOpenAI, Model: terraMaxAlias, BaseURL: f.srv.URL + "/v1"}
+	if result := Check(context.Background(), cfg, "test-only", f.srv.Client()); !result.OK {
+		t.Fatalf("check did not accept the response: %+v", result)
+	}
+	paths := f.paths()
+	if len(paths) != 1 || paths[0] != "/v1/responses" {
+		t.Fatalf("expected one Responses request, got %v", paths)
+	}
+	body := f.last().body
+	reasoning, ok := body["reasoning"].(map[string]any)
+	if body["model"] != "gpt-6.1-terra" || !ok || reasoning["effort"] != "max" {
+		t.Fatalf("unexpected response request: %v", body)
+	}
+}
